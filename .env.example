# Environment variables for tatool-web Docker container

# Node.js Environment
NODE_ENV=production

# Server Configuration
PORT=3000

# Database Configuration
# For MongoDB on host machine (Windows/Mac Docker Desktop)
DB_URI=mongodb://host.docker.internal:27017/tatool-web
# For MongoDB on Linux host machine
# DB_URI=mongodb://172.17.0.1:27017/tatool-web
# For MongoDB in another Docker container (same docker-compose)
# DB_URI=mongodb://mongodb:27017/tatool-web

# JWT Secret - REQUIRED. The server refuses to start when NODE_ENV=production and this is unset
# (or set to the old default 'secret'), because a known signing key makes admin tokens forgeable.
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production

# Self-registration. Disabled by default: the endpoint is unauthenticated and needs both a working
# captcha and a working mail transport before it is safe to expose. Accounts are provisioned with
# tatool-users.js instead. Set to 'true' only once captcha and email are configured.
REGISTRATION_ENABLED=false

# Projects Path Configuration
PROJECTS_PATH_TYPE=local
PROJECTS_PATH=/app/app/projects/

# Private Path Configuration
PRIVATE_PATH_TYPE=local
PRIVATE_PATH=/app/app/projects/

# reCAPTCHA Configuration (only needed if REGISTRATION_ENABLED=true)
RECAPTCHA_PRIVATE_KEY=

# Editor User (optional)
EDITOR_USER=

# Email (only needed if REGISTRATION_ENABLED=true, or for password-reset emails).
# SENDER_EMAIL is required by both transports below.
# SENDER_EMAIL=
# Postmark transport (preferred if set):
# POSTMARK_API_KEY=
# Otherwise nodemailer, which is currently hardcoded to Gmail:
# MAIL_USER=
# MAIL_PW=

# Google Cloud Storage (if using GCS instead of local storage)
# PROJECTS_PATH_TYPE=gcs
# PROJECTS_PATH=your-gcs-bucket-name
# PRIVATE_PATH_TYPE=gcs
# PRIVATE_PATH=your-gcs-bucket-name
